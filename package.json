{
  "name": "sini-vscode",
  "displayName": "sini: Lean ⇄ blueprint",
  "description": "→'Show in PDF', ←Ctrl+click a \\label",
  "version": "0.1.0",
  "publisher": "l-oksanen",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/l-oksanen/sini-vscode.git"
  },
  "engines": {
    "vscode": "^1.96.0"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "lean",
    "lean4",
    "latex",
    "blueprint",
    "sini"
  ],
  "activationEvents": [
    "onLanguage:lean4",
    "onLanguage:latex"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "configuration": {
      "title": "sini",
      "properties": {
        "sini.exclude": {
          "type": "string",
          "default": "**/{.lake,.git,node_modules}/**",
          "scope": "window",
          "markdownDescription": "Files not searched. `.lake` matters: a project's Lake packages hold every Mathlib source, and searching them would cost far more than the rest of the workspace put together."
        }
      }
    },
    "commands": [
      {
        "command": "sini.showInPdf",
        "title": "Show in PDF"
      }
    ],
    "keybindings": [
      {
        "command": "sini.showInPdf",
        "key": "ctrl+alt+b",
        "mac": "cmd+alt+b",
        "when": "editorLangId == lean4"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "sini.showInPdf",
          "when": "editorLangId == lean4"
        }
      ]
    }
  },
  "scripts": {
    "clean": "rm -rf out",
    "compile": "tsc -p .",
    "watch": "tsc -watch -p .",
    "link": "scripts/install.sh",
    "unlink": "scripts/uninstall.sh",
    "test": "npm run clean && tsc -p . && node test/encoding.test.js && node test/nodes.test.js && node test/links.test.js",
    "prepare": "npm run clean && tsc -p .",
    "package": "npm run clean && tsc -p . && vsce package"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "@types/vscode": "^1.96.0",
    "@vscode/vsce": "^3.9.2",
    "typescript": "^5.5.0"
  }
}
